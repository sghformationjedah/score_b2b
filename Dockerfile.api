FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Installation de FastAPI, PostgreSQL et du runtime Machine Learning
RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    psycopg2-binary \
    pandas \
    joblib \
    scikit-learn \
    xgboost\
    shap

# Copie de l'ensemble du projet (code + artefact du modèle)
COPY . .

# Port par défaut si la variable PORT n'est pas définie (ex: en local)
ENV PORT=8000
EXPOSE 8000  

#CMD ["uvicorn", "03_api:app", "--host", "0.0.0.0", "--port", "8000"]
# Lancement via un sous-shell pour évaluer dynamiquement la variable ${PORT} injectée par Render
CMD ["sh", "-c", "uvicorn 03_api:app --host 0.0.0.0 --port ${PORT}"]